# Homebrew の PATH を全 zsh 起動タイミング (login/non-login) で通す。
# .zprofile は login shell でしか実行されないため、Ghostty 等の
# non-login 起動で /opt/homebrew/bin が欠けるのを防ぐ目的で .zshenv に置く。
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# zoxide doctor はスナップショットベースのサブシェル (Claude Code 等) で
# chpwd_functions が復元されず誤検知するため無効化する
export _ZO_DOCTOR=0

[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
{{- if eq .machine "server" }}

# SSH の非対話コマンド（Orca のエージェントなど）でも使えるように PATH をここで通す。
# .zshrc の mise activate は対話シェルでしか効かないので shims を足す。
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

# 2026-11-06: Remote Control は長期トークン（推論専用）では使えないので、Claude Code は
# `claude auth login` のフルスコープ認証に切り替えた。トークンの export は外してある。
# 戻すときは次の行のコメントを外す（トークンファイルは残してある）。
# claude-mem のワーカーは ~/.local/bin/claude-mem-worker.sh が自分でファイルを読む。
# [ -r "$HOME/.config/claude-code/oauth-token" ] && export CLAUDE_CODE_OAUTH_TOKEN="$(cat "$HOME/.config/claude-code/oauth-token")"
{{- end }}
