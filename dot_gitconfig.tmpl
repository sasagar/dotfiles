[user]
	name = SASAGAWA Kiyoshi
	email = {{ .email_personal }}
	signingkey = C872B16845393388
[includeIf "gitdir:~/ghq/github.com/lapras-inc/"]
	path = ~/.gitconfig-lapras
{{- if ne .machine "work" }}
[includeIf "gitdir/i:~/ghq/github.com/love-rox/"]
	path = ~/.gitconfig-love-rox
{{- end }}
[init]
	defaultBranch = main
[pull]
	ff = only
[core]
	autocrlf = input
{{- if eq .machine "server" }}
	editor = vim
{{- else }}
	editor = code --wait
{{- end }}
{{- if eq .machine "server" }}
# SSH のセッションからはキーチェーン（osxkeychain）が読めないので、GitHub の https は gh のトークンで通す
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
{{- end }}
[commit]
	gpgsign = true
[tag]
	gpgSign = true
{{- if eq .machine "personal" }}
[coderabbit]
	machineId = cli/4b44134edc4046af9dc17378b55b82b9
{{- end }}
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
