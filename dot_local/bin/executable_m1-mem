#!/bin/zsh
# M1（正本）の claude-mem を M4 から SSH 越しに引く（personal のみ。chezmoi が管理）。
# claude-mem の DB は 2 台で別々に持ち、同期しない（2026-11-04 に決めた）。M1 で作業した経緯が要るときだけこれで見にいく。
#   m1-mem search <言葉> [-p プロジェクト] [-n 件数]   一覧（ID・日時・題）
#   m1-mem timeline <ID> [前後の件数]                その前後の流れ
#   m1-mem get <ID>...                               詳細（本文・事実・触ったファイル）
set -eu
export PATH="/opt/homebrew/bin:/usr/bin:/bin"
api() { ssh -o BatchMode=yes -o ConnectTimeout=10 m1 "curl -sf $*" || { echo "M1 の claude-mem に届かない（M1 が落ちているかワーカーが止まっている）" >&2; exit 1; }; }
uri() { jq -rn --arg v "$1" '$v|@uri'; }

cmd=${1:-}; [ $# -gt 0 ] && shift
case $cmd in
  search)
    project="" limit=20 words=()
    while [ $# -gt 0 ]; do
      case $1 in -p) project=$2; shift 2 ;; -n) limit=$2; shift 2 ;; *) words+=$1; shift ;; esac
    done
    [ ${#words} -gt 0 ] || { echo "使い方: m1-mem search <言葉> [-p プロジェクト] [-n 件数]" >&2; exit 2; }
    q="query=$(uri "${words[*]}")&limit=$limit"
    [ -n "$project" ] && q="$q&project=$(uri "$project")"
    api "'http://127.0.0.1:37777/api/search?$q'" | jq -r '.content[0].text' ;;
  timeline)
    [ $# -ge 1 ] || { echo "使い方: m1-mem timeline <ID> [前後の件数]" >&2; exit 2; }
    d=${2:-3}
    api "'http://127.0.0.1:37777/api/timeline?anchor=$1&depth_before=$d&depth_after=$d'" | jq -r '.content[0].text' ;;
  get)
    [ $# -ge 1 ] || { echo "使い方: m1-mem get <ID>..." >&2; exit 2; }
    body=$(jq -cn --args '{ids: [$ARGS.positional[] | tonumber]}' "$@")
    api "-X POST -H content-type:application/json -d '$body' http://127.0.0.1:37777/api/observations/batch" \
      | jq -r '.[] | "### #\(.id) \(.title)  [\(.project) \(.created_at)]\n\(.narrative // .text // "")\n\((.facts // "[]") | fromjson? // [] | map("- " + .) | join("\n"))\n変更: \(.files_modified // "[]")\n"' ;;
  *)
    sed -n '3,7p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
